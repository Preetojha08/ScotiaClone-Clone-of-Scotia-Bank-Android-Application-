    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_margin="@dimen/_11sdp"
        android:layout_height="wrap_content"
        android:elevation="4dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_170sdp"
            android:background="@drawable/gradient_bg"
            android:orientation="vertical"
            application:ignore="ExtraText">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/dotted_world_bg"
                android:alpha="0.5"
                android:padding="@dimen/_8sdp"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"
                app:tint="@color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Card Name"
                android:textSize="@dimen/_12sdp"
                android:textStyle="bold"
                android:shadowColor="@color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:layout_margin="@dimen/_15sdp"
                android:id="@+id/cardTitle"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:fontFamily="@font/scotia_bold"
                android:textColor="@color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$1700.00"
                android:textSize="@dimen/_20sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:id="@+id/accountbalance"
                android:textStyle="bold"
                android:layout_centerVertical="true"
                android:shadowColor="@color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:fontFamily="@font/scotia_bold"
                android:textColor="@color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balance"
                android:shadowColor="@color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:textSize="@dimen/_12sdp"
                android:textStyle="bold"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_below="@id/accountbalance"
                android:fontFamily="@font/scotia_bold"
                android:textColor="@color/white"/>

            <ImageView
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_45sdp"
                android:src="@drawable/new_chip"
                android:layout_marginHorizontal="@dimen/_18sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_centerVertical="true"
                android:alpha="0.3"
                android:layout_alignParentRight="true"
                app:tint="@color/black" />

            <ImageView
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:src="@drawable/new_chip"
                android:layout_marginHorizontal="@dimen/_20sdp"
                android:layout_centerVertical="true"
                android:paddingBottom="@dimen/_2sdp"
                android:layout_alignParentRight="true"/>

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>


</RelativeLayout>